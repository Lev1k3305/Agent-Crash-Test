# ==============================================================================
# Agent Crash Test — Local-First Environment Variables (.env.example)
# Copy this file to .env for local development. Never commit real secrets to Git.
# ==============================================================================

# Backend Service Configuration
APP_ENV=development
APP_NAME="Agent Crash Test"
APP_VERSION=1.0.0
API_VERSION=v1
LOG_LEVEL=INFO
PORT=8000

# Local-First Persistent Database (SQLite 3 with WAL & Foreign Keys)
# If omitted or blank, defaults to absolute path data/agent_crash_test.db
DATABASE_URL=sqlite:///data/agent_crash_test.db
DATA_DIR=data

# CORS Configuration (comma-separated list of trusted origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
# Centralized API base URL pointing to local FastAPI backend on port 8000
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
